# Local: leave SHOP_STORAGE=local and Google credentials unset to retain the demo.
SHOP_STORAGE=local
# Hosted configuration: SHOP_STORAGE=starserver (always uses memory sessions).
SHOP_SESSION_MODE=memory
SHOP_BACKUP_INTERVAL_MS=0
SITE_URL=http://localhost:5173
# STARSERVER_API_URL=https://YOUR_STARSERVER_HOST/slide-market/index.php
# STARSERVER_API_KEY=RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
# First seed / migration can use explicit administrator passwords:
# LOCAL_ADMIN_PASSWORD=CHOOSE_A_STRONG_PASSWORD
# LOCAL_EDITOR_PASSWORD=CHOOSE_A_DIFFERENT_STRONG_PASSWORD
