{
  "name": "slide-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node 02.src/scripts/generate-seo.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "generate": "node 02.src/scripts/generate-slides.mjs",
    "test": "playwright test",
    "backup": "node 02.src/scripts/local-data.mjs backup",
    "restore": "node 02.src/scripts/local-data.mjs restore",
    "admin:reset": "node 02.src/scripts/local-data.mjs admin-reset",
    "test:server": "node --test 02.src/tests/server.test.mjs 02.src/tests/assets.test.mjs",
    "admin:otp": "node 02.src/scripts/local-data.mjs admin-code",
    "assets:prepare": "node 02.src/scripts/prepare-assets.mjs",
    "tools:check": "node 02.src/scripts/prepare-assets.mjs --check",
    "backup:list": "node 02.src/scripts/local-data.mjs backup-list",
    "backup:check": "node 02.src/scripts/local-data.mjs backup-check",
    "restore:drill": "node 02.src/scripts/local-data.mjs restore-drill",
    "test:tools": "node --test 02.src/tests/tools.test.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "openid-client": "^6.8.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pptxgenjs": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
